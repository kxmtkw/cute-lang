{
  "name": "cute-lang",
  "displayName": "Cute Language Support",
  "description": "Syntax highlighting and editor configuration for the Cute language.",
  "version": "0.1.0",
  "publisher": "cute-lang",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "cute",
        "aliases": [
          "Cute",
          "cute"
        ],
        "extensions": [
          ".ct"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cute",
        "scopeName": "source.cute",
        "path": "./syntaxes/cute.tmLanguage.json"
      }
    ]
  }
}
